APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-in-production

# LLM Providers (configure at least one)
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# Embedding
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=models/embedding-001
EMBEDDING_DIMENSION=768

# Database: MongoDB (Default) or PostgreSQL
DATABASE_TYPE=mongodb
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=freshweb_rag

# External services (Docker Compose service names)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/freshweb
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

# Retrieval settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
RERANK_TOP_K=3

# Web search
TAVILY_API_KEY=your-tavily-api-key-here
MAX_WEB_SEARCH_ITERATIONS=2
MAX_WEB_SOURCES=5

# Memory
MEMORY_ENABLED=true
MEMORY_RETRIEVAL_TOP_K=5
MEMORY_CONFIDENCE_THRESHOLD=0.75
MEMORY_IMPORTANCE_THRESHOLD=0.5

# Verification
MAX_VERIFICATION_RETRIES=1

# Cache TTLs (seconds)
CACHE_TTL_DEFAULT=300
CACHE_TTL_WEB_SEARCH=600
CACHE_TTL_MEMORY=120

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# CORS (comma-separated origins or *)
CORS_ORIGINS=*

# Qdrant collections
QDRANT_COLLECTION_DOCUMENTS=documents
QDRANT_COLLECTION_MEMORY=memory

